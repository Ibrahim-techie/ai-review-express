# Copy to .env and fill in. At least one key is required.
# Groq:   https://console.groq.com/keys
# Gemini: https://aistudio.google.com/apikey
GROQ_API_KEY=
GEMINI_API_KEY=

NODE_ENV=development
PORT=3000

# Only needed when the frontend runs on a different origin than the API.
# Comma-separated. Not needed in production when the API serves the frontend.
CORS_ORIGIN=http://localhost:5173

# ---- Optional tuning (defaults shown) ----------------------------------------
# Reverse proxies in front of the app; 1 for Render, Railway, Fly, Heroku.
# TRUST_PROXY=1
# MAX_CODE_CHARS=60000
# RATE_LIMIT_PER_MINUTE=6
# RATE_LIMIT_PER_DAY=150
# CACHE_MAX_ENTRIES=200
# CACHE_TTL_MINUTES=60

# Models are tried in order; each Groq model has its own free-tier quota.
# GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
# GROQ_TPM_LIMIT=8000
# GROQ_TIMEOUT_MS=45000
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite
# GEMINI_DEEP_MODELS=gemini-4-hydrogen,gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite
# GEMINI_TIMEOUT_MS=70000
# GEMINI_DEEP_TIMEOUT_MS=150000
# GEMINI_BUDGET_MS=170000
